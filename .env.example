# Django
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=
POSTGRES_DB=cmms
POSTGRES_USER=cmms
POSTGRES_PASSWORD=cmms
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
RUN_MIGRATIONS=0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_FORMAT=plain

# Microservices
AUDIT_LOCAL_WRITE=True
EVENT_BUS_URL=
JWKS_URL=
SERVICE_NAME=monolith
# Optional OpenTelemetry HTTP endpoint; for local Jaeger use http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_KID=cmms-identity-1
IDENTITY_POSTGRES_DB=identity
IDENTITY_POSTGRES_USER=identity
IDENTITY_POSTGRES_PASSWORD=identity
IDENTITY_POSTGRES_HOST=identity-db
IDENTITY_POSTGRES_PORT=5432
AUDIT_POSTGRES_DB=audit
AUDIT_POSTGRES_USER=audit
AUDIT_POSTGRES_PASSWORD=audit
AUDIT_POSTGRES_HOST=db
AUDIT_POSTGRES_PORT=5432
